# Steam Workshop Update - Integration Test Configuration
# Copy this file to config.env and fill in your test credentials
# NEVER commit config.env with real credentials!

# Required: Steam account credentials for testing
# Use a dedicated test account, NOT your main account
STEAM_USERNAME="your_test_steam_username"
STEAM_PASSWORD="your_test_steam_password"

# Optional: Steam Guard 2FA seed (for TOTP authentication testing)
# Get this from your Steam Guard mobile authenticator setup
# Leave empty if not using 2FA
STEAM_2FASEED=""

# Required: Steam AppID that owns the workshop item
# Must be a valid AppID you have permission to publish to
STEAM_APPID="123456"

# Required: PublishedFileID (workshop item ID) to update
# Must be an existing workshop item owned by STEAM_USERNAME
STEAM_ITEMID="123456789012345678"

# Required: Path to test content directory (relative to GITHUB_WORKSPACE)
# This directory will be created and populated with test content
# Must be within the workspace for path validation
STEAM_WORKSPACE_PATH="/home/horatiu/Proiecte/github-actions/steam-workshop-update/tests/integration/test_content"

# Optional: Custom changenote prefix for test runs
# STEAM_CHANGENOTE_PREFIX="Integration Test"